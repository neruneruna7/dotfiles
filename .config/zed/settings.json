  "terminal": {
    "shell": {
      "program": "nu",
    },
    "font_size": 12.0,
    "font_family": "MesloLGM Nerd Font Mono",
    "font_fallbacks": ["Cica", "Courier New"],
  },
  "telemetry": {
    "diagnostics": true,
    "metrics": true,
  },
  "base_keymap": "VSCode",
  "minimap": {
    "show": "auto",
  },
  "buffer_font_fallbacks": ["Cica", "Courier New", "MesloLGM Nerd Font Mono"],
  "buffer_line_height": "comfortable",
  "buffer_font_family": "Cica",
  "file_types": {},
  "show_whitespaces": "all",
  "show_edit_predictions": true,
  "ui_font_size": 18.0,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Ayu Dark",
  },

  // インデントの設定
  // indent-rainbow みたいな
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware",
    "background_coloring": "indent_aware",
  },

  // カッコの色付け
  "colorize_brackets": true,

  // タブにファイルアイコンとgitステータスを表示
  "tabs": {
    "file_icons": true,
    "git_status": true,
  },

  // インラインでエラーや警告を表示
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "inlay_hints": {
    "enabled": true,
  },
  // podmanを使う
  "use_podman": true,

