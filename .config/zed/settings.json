  // カラーユニバーサルデザインからの配色セット
  "theme_overrides": {
    "Ayu Dark": {
      "editor.background": "#1e1e1e",

      "error": "#f2e700",
      "error.background": "#f2e7001f",
      "error.border": "#f2e700",

      "warning": "#f6aa00",
      "warning.background": "#f6aa001f",
      "warning.border": "#f6aa00",

      "syntax": {
        "invalid": {
          "color": "#f2e700",
        },
        "comment": {
          "font_style": "italic",
        },
        "title": {
          "color": "#84919e",
          "font_weight": 700,
        },
        "string": {
          "color": "#00b06b",
        },
        "link_text": {
          // "color": "#00b06b",
        },
        "link_uri": {
          "color": "#4dc4ff",
        },
        "emphasis": {
          "font_style": "italic",
        },
        "strong": {
          "font_weight": 700,
        },
        "code": {
          "color": "#f2e700",
        },
      },

      "accents": ["#00b06b", "#1971ff", "#f2e700", "#990099"],
    },
  },
